# Public key used by the browser reCAPTCHA widget
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Server-only secret key for classic reCAPTCHA v2 verification.
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Optional URL for the Express proxy
VITE_GEO_PROXY_URL=http://localhost:5174

# Existing LocationIQ proxy setting
LOCATIONIQ_KEY=your_locationiq_key
