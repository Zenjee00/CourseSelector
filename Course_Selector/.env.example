# Browser configuration. Never use VITE_ for a server secret.
VITE_RECAPTCHA_SITE_KEY=your_public_recaptcha_site_key
# Leave empty for same-origin production APIs; Vite proxies /api during development.
VITE_GEO_PROXY_URL=

# Server-only configuration
LOCATIONIQ_KEY=your_server_locationiq_key
RECAPTCHA_SECRET_KEY=your_server_recaptcha_secret_key
# Comma-separated, exact frontend origins. Required with NODE_ENV=production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1
PORT=5174
# Set only when behind a known number of reverse proxies; otherwise omit.
# TRUST_PROXY_HOPS=1
# VITE_USE_FIREBASE_EMULATOR=true

# Optional overrides for a separate staging Firebase project.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
