      "css": ".ds-nav { display: flex; align-items: center; gap: 1rem; font-family: var(--font-body); } .ds-nav a, .ds-nav button { display: inline-flex; align-items: center; min-height: 44px; padding: .6rem; background: transparent; border: 0; text-decoration: none; color: var(--text-main); font-size: .875rem; } .ds-nav a:hover, .ds-nav button:hover { background: var(--primary-soft); } .ds-nav a:focus-visible { outline: 3px solid var(--primary); outline-offset: 4px; } .ds-nav button:focus-visible { outline: 3px solid var(--primary); outline-offset: 4px; }"
